# Copy this file to .env and change the values.
APP_NAME=Scrap Pickup
APP_CITY=Hyderabad
PORT=3000

# Where the database file is stored
DB_PATH=data/app.db

# test = everyone logs in with TEST_OTP (development only!)
# sms  = a real random OTP is sent by SMS (needs a provider, see server/sms.js)
OTP_MODE=test
TEST_OTP=123456

# For a private trial on a public link: hide the test OTP from the login page,
# and allow test mode even when NODE_ENV=production
HIDE_TEST_OTP=0
ALLOW_TEST_OTP=0

# Mobile numbers made admin at start-up (use when the host has no command line)
ADMIN_MOBILES=

# Set to 1 when the app runs behind HTTPS (always, in production)
COOKIE_SECURE=0
# Set to 1 if the app is behind a reverse proxy (Nginx, Hostinger, Render...)
TRUST_PROXY=0
